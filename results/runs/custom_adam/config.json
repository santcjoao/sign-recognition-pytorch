{
    "experiment_name": "custom_adam",
    "model_config": {
        "name": "custom",
        "dropout": 0.3,
        "data_augmentation": true,
        "batch_normalization": true,
        "image_size": 48,
        "base_channels": 64,
        "num_blocks": 4
    },
    "hyperparameters": {
        "epochs": 25,
        "batch_size": 64,
        "optimizer_name": "adam",
        "learning_rate": 0.001,
        "momentum": 0.0,
        "weight_decay": 0.0,
        "label_smoothing": 0.0,
        "scheduler": {
            "name": "cosine_annealing",
            "kwargs": {
                "T_max": 25,
                "eta_min": 1e-06
            }
        }
    }
}